{
  "name": "gacha-calendar-extension",
  "version": "0.2.3",
  "private": true,
  "description": "二游日历：28 款二次元手游的当期卡池与活动起止速查（Chrome/Edge MV3 扩展）。",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "verify": "node verify.mjs",
    "verify:domains": "node tools/check-domains.mjs",
    "verify:zip": "node build.mjs --zip && node tools/verify-zip.mjs release/gacha-calendar-extension-${npm_package_version}.zip",
    "verify:live": "node verify-live.mjs",
    "verify:chromium": "node tools/verify-chromium.mjs",
    "test": "node tools/test-domain-guard.mjs && node tools/test-entry-meta.mjs && node tools/test-options.mjs",
    "test:domains": "node tools/test-domain-guard.mjs",
    "test:meta": "node tools/test-entry-meta.mjs",
    "test:options": "node tools/test-options.mjs",
    "store:check": "node tools/check-listing.mjs",
    "store:assets": "node tools/make-store-assets.mjs",
    "store:serve": "node tools/serve-shot.mjs 8899",
    "store:publish": "node tools/edge-publish.mjs",
    "store:dry-run": "node tools/edge-publish.mjs --dry-run",
    "icons": "node make-icons.mjs",
    "zip": "node build.mjs --zip"
  },
  "dependencies": {
    "gacha-calendar-core": "^0.11.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastMG/gacha-calendar-extension.git"
  }
}
