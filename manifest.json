{
  "manifest_version": 3,
  "name": "二游排期",
  "version": "0.1.4",
  "description": "11 款二次元手游的当期卡池与活动起止一览：原神/星铁/绝区零/鸣潮/明日方舟/终末地/蔚蓝档案三服/重返未来1999/异环。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "二游排期",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://wiki.biligame.com/*",
    "https://prts.wiki/*",
    "https://api-takumi-static.mihoyo.com/*",
    "https://aki-gm-resources-back.aki-game.com/*",
    "https://aki-gm-resources.aki-game.com/*",
    "https://web-news.hypergryph.com/*",
    "https://end.canmoe.com/*",
    "https://fz.wiki/*",
    "https://endfield.wiki.gg/*",
    "https://gachatracker.app/*",
    "https://game8.co/*",
    "https://yh.wanmei.com/*",
    "https://www.ldshop.gg/*",
    "https://bluearchive-cn.com/*",
    "https://forum.nexon.com/*",
    "https://api-web.bluearchive.jp/*",
    "https://re.bluepoch.com/*",
    "https://game.xiaomi.com/*",
    "https://www.gamekee.com/*",
    "https://storage.moegirl.org.cn/*",
    "https://webcnstatic.yostar.net/*",
    "https://play-lh.googleusercontent.com/*",
    "https://ak.hypergryph.com/*",
    "https://zzz.mihoyo.com/*",
    "https://bluearchive.jp/*",
    "https://notice.sl916.com/*",
    "https://www.sl916.com/*"
  ],
  "minimum_chrome_version": "102"
}
